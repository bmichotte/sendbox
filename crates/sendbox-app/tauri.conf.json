{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sendbox",
  "identifier": "be.michotte.sendbox",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sendbox",
        "width": 880,
        "height": 600,
        "minWidth": 420,
        "minHeight": 300,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Sendbox Settings",
        "width": 480,
        "height": 360,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
